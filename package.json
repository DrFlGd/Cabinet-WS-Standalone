{
  "name": "cabinet-ws-standalone",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:dist": "npm run build && electron-builder --win portable",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.185.1",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "44.4.3",
    "typescript": "5.9.3",
    "wait-on": "9.0.1",
    "electron-builder": "^26.0.12",
    "vitest": "^4.0.17"
  },
  "build": {
    "appId": "com.cabinetworkshop.standalone",
    "productName": "Cabinet WS Standalone",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Cabinet-WS-Standalone-${version}-Windows-x64.${ext}"
    }
  }
}
